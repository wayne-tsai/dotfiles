# Added by OrbStack: 'orb' SSH host for Linux machines
# This only works if it's at the top of ssh_config (before any Host blocks).
# This won't be added again if you remove it.
Include ~/.orbstack/ssh/config

# SSH client configuration
# Man page: man ssh_config

# ── GitHub accounts ───────────────────────────────────────────────────────────
# Two accounts on one host. SSH picks the account, so each needs its own alias.
# These MUST stay above `Host *`: IdentityFile accumulates rather than overrides,
# so whichever key is added first is offered first and wins.

Host github.com
    HostName     github.com
    User         git
    IdentityFile ~/.ssh/id_ed25519
    ControlPath  ~/.ssh/sockets/%n-%r@%h:%p

Host github-work
    HostName     github.com
    User         git
    IdentityFile ~/.ssh/dareesoft
    ControlPath  ~/.ssh/sockets/%n-%r@%h:%p

# ── Global defaults ───────────────────────────────────────────────────────────
Host *
    # Reuse connections to the same host (speeds up git, ansible, etc.)
    ControlMaster auto
    ControlPath   ~/.ssh/sockets/%r@%h:%p
    ControlPersist 10m

    # Keep connection alive through NAT / firewalls
    ServerAliveInterval 60
    ServerAliveCountMax 3

    # Only offer keys explicitly listed; prevents accidental key leaks
    IdentitiesOnly yes

    # Use the strongest available host-key algorithm first
    HostKeyAlgorithms ssh-ed25519,ecdsa-sha2-nistp256,ssh-rsa

    # Prefer ed25519, fall back to RSA
    IdentityFile ~/.ssh/id_ed25519
    IdentityFile ~/.ssh/id_rsa

    # Compression helps on slow links (mosh handles this itself, but useful for SCP)
    Compression yes

    # Forward agent only when explicitly needed — keep off by default
    ForwardAgent no

    # Hash known_hosts for privacy
    HashKnownHosts yes

    # Quiet output — remove if you want verbose connection info
    LogLevel ERROR

# ── Jump host / bastion template ──────────────────────────────────────────────
# Uncomment and adapt when you have a bastion host:
#
# Host bastion
#     HostName      bastion.example.com
#     User          wayne
#     IdentityFile  ~/.ssh/id_ed25519
#
# Host 10.0.0.*
#     ProxyJump     bastion
#     User          wayne

