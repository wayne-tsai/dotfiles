# ── Backups created by link-configs.sh ───────────────────────────────────────
home.bak/

# ── Secrets — never commit these ─────────────────────────────────────────────
home/.ssh/id_*
home/.ssh/known_hosts
home/.ssh/authorized_keys
home/.ssh/sockets/
home/.netrc
home/.gnupg/

# ── p10k cache & instant-prompt ───────────────────────────────────────────────
home/.cache/
# machine-generated; commit your own copy explicitly
home/.p10k.zsh

# ── Zim compiled files ────────────────────────────────────────────────────────
home/.local/share/zim/

# ── Editor droppings ─────────────────────────────────────────────────────────
*.swp
*.swo
*~

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.claude/

# ── Wallpaper renders ─────────────────────────────────────────────────────────
# 8-9 MB each; re-render from the SVG with inkscape
wallpaper/*.png
# scratch seeds; keep only the catppuccin-topo-* sources
wallpaper/topo*.svg
